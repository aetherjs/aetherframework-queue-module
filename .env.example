# ============================================
# QUEUE SYSTEM CONFIGURATION
# ============================================

# ============================================
# GENERAL CONFIGURATION
# ============================================

# Default queue driver to use
# Options: memory, shared-memory, file, redis, mq, kafka, bullmq
QUEUE_DRIVER=memory

# Default queue name
QUEUE_NAME=default-queue

# Default concurrency (number of jobs processed simultaneously)
QUEUE_CONCURRENCY=5

# Maximum retry attempts for failed jobs
QUEUE_MAX_RETRIES=3

# Base delay for retries in milliseconds (exponential backoff)
QUEUE_RETRY_DELAY=1000

# Job timeout in milliseconds
QUEUE_TIMEOUT=30000

# Polling interval for queue processing in milliseconds
QUEUE_POLL_INTERVAL=100

# Auto-start queue processing on initialization
QUEUE_AUTO_START=true

# ============================================
# MEMORY DRIVER CONFIGURATION
# ============================================

# Maximum queue size for memory driver
MEMORY_DRIVER_MAX_SIZE=10000

# Enable persistence to disk for memory driver
MEMORY_DRIVER_PERSIST=false

# Path for memory driver persistence
MEMORY_DRIVER_PERSISTENCE_PATH=./queue-data

# ============================================
# SHARED MEMORY DRIVER CONFIGURATION
# ============================================

# Shared directory path for inter-process communication
SHARED_MEMORY_PATH=/tmp/queue-shared

# Lock timeout in milliseconds for shared memory driver
SHARED_MEMORY_LOCK_TIMEOUT=5000

# Cleanup interval in milliseconds for shared memory driver
SHARED_MEMORY_CLEANUP_INTERVAL=60000

# Maximum queue size per node for shared memory driver
SHARED_MEMORY_MAX_SIZE=10000

# Enable persistence for shared memory driver
SHARED_MEMORY_PERSIST=true

# Unique node identifier (auto-generated if not provided)
NODE_ID=node_${RANDOM_HEX}

# ============================================
# FILE DRIVER CONFIGURATION
# ============================================

# Directory to store queue data for file driver
FILE_DRIVER_DATA_DIR=./data/queues

# ============================================
# CLUSTER CONFIGURATION
# ============================================

# Enable cluster mode for multi-node support
CLUSTER_ENABLED=false

# Minimum number of worker processes
CLUSTER_MIN_WORKERS=1

# Maximum number of worker processes (based on CPU cores)
CLUSTER_MAX_WORKERS=${CPU_CORES}

# Worker restart delay in milliseconds
CLUSTER_WORKER_RESTART_DELAY=1000

# Graceful shutdown timeout in milliseconds
CLUSTER_GRACEFUL_SHUTDOWN_TIMEOUT=30000

# Health check interval in milliseconds
CLUSTER_HEALTH_CHECK_INTERVAL=5000

# ============================================
# CLUSTER MANAGER CONFIGURATION
# ============================================

# Heartbeat interval for cluster coordination in milliseconds
CLUSTER_HEARTBEAT_INTERVAL=1000

# Election timeout for leader election in milliseconds
CLUSTER_ELECTION_TIMEOUT=5000

# Coordination driver type for cluster manager
# Options: memory, shared-memory
CLUSTER_COORDINATION_DRIVER=memory

# Auto-start cluster manager
CLUSTER_AUTO_START=true

# ============================================
# JOB SCHEDULER CONFIGURATION
# ============================================

# Scheduler name for identification
SCHEDULER_NAME=scheduler_${RANDOM_HEX}

# Maximum concurrent jobs for scheduler
SCHEDULER_CONCURRENCY=5

# Polling interval for scheduler in milliseconds
SCHEDULER_POLL_INTERVAL=100

# ============================================
# QUEUE WORKER CONFIGURATION
# ============================================

# Worker name for identification
WORKER_NAME=worker-${RANDOM_HEX}

# Worker concurrency (number of jobs processed simultaneously)
WORKER_CONCURRENCY=1

# Worker timeout in milliseconds
WORKER_TIMEOUT=30000

# Auto-start worker on initialization
WORKER_AUTO_START=true

# ============================================
# QUEUE MANAGER CONFIGURATION
# ============================================

# Auto-start queue manager
QUEUE_MANAGER_AUTO_START=true

# Health check interval for queue manager in milliseconds
QUEUE_MANAGER_HEALTH_CHECK_INTERVAL=30000

# Maximum number of queues managed by queue manager
QUEUE_MANAGER_MAX_QUEUES=100

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level for queue system
# Options: debug, info, warn, error
QUEUE_LOG_LEVEL=info

# Enable verbose logging for debugging
QUEUE_VERBOSE_LOGGING=false

# Log file path (empty for console only)
QUEUE_LOG_FILE=

# ============================================
# MONITORING CONFIGURATION
# ============================================

# Enable metrics collection
QUEUE_METRICS_ENABLED=true

# Metrics collection interval in milliseconds
QUEUE_METRICS_INTERVAL=60000

# Enable health check endpoints
QUEUE_HEALTH_CHECK_ENABLED=true

# Health check port
QUEUE_HEALTH_CHECK_PORT=8080

# ============================================
# PERFORMANCE CONFIGURATION
# ============================================

# Enable job batching for better performance
QUEUE_BATCHING_ENABLED=true

# Batch size for job processing
QUEUE_BATCH_SIZE=100

# Enable compression for large job payloads
QUEUE_COMPRESSION_ENABLED=false

# Compression threshold in bytes
QUEUE_COMPRESSION_THRESHOLD=10240

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Enable authentication for queue access
QUEUE_AUTH_ENABLED=false

# Authentication token for queue access
QUEUE_AUTH_TOKEN=

# Enable encryption for job payloads
QUEUE_ENCRYPTION_ENABLED=false

# Encryption key for job payloads
QUEUE_ENCRYPTION_KEY=

# ============================================
# REDIS DRIVER CONFIGURATION (if using Redis)
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis database number
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Redis connection timeout in milliseconds
REDIS_CONNECT_TIMEOUT=10000

# Redis key prefix for queue data
REDIS_KEY_PREFIX=queue:

# ============================================
# KAFKA DRIVER CONFIGURATION (if using Kafka)
# ============================================

# Kafka broker addresses (comma-separated)
KAFKA_BROKERS=localhost:9092

# Kafka client ID
KAFKA_CLIENT_ID=queue-client

# Kafka consumer group ID
KAFKA_GROUP_ID=queue-group

# Kafka topic for queue messages
KAFKA_TOPIC=queue-topic

# ============================================
# BULLMQ DRIVER CONFIGURATION (if using BullMQ)
# ============================================

# Redis connection for BullMQ
BULLMQ_REDIS_URL=redis://localhost:6379

# BullMQ queue name prefix
BULLMQ_PREFIX=bull

# BullMQ default job options
BULLMQ_DEFAULT_JOB_OPTIONS={"attempts": 3, "backoff": {"type": "exponential", "delay": 1000}}

# ============================================
# MESSAGE QUEUE DRIVER CONFIGURATION (if using MQ)
# ============================================

# Message queue connection URL
MQ_URL=amqp://localhost:5672

# Message queue exchange name
MQ_EXCHANGE=queue-exchange

# Message queue routing key
MQ_ROUTING_KEY=queue-routing-key

# ============================================
# ADVANCED CONFIGURATION
# ============================================

# Enable dead letter queue for failed jobs
DEAD_LETTER_QUEUE_ENABLED=true

# Dead letter queue name
DEAD_LETTER_QUEUE_NAME=dead-letter-queue

# Maximum age for completed jobs in milliseconds (0 = never cleanup)
JOB_RETENTION_MS=86400000

# Enable job prioritization
JOB_PRIORITIZATION_ENABLED=true

# Maximum job payload size in bytes
MAX_JOB_PAYLOAD_SIZE=1048576

# Enable job deduplication
JOB_DEDUPLICATION_ENABLED=false

# Deduplication window in milliseconds
JOB_DEDUPLICATION_WINDOW=60000

# ============================================
# DEVELOPMENT CONFIGURATION
# ============================================

# Enable development mode (more verbose logging)
NODE_ENV=development

# Enable hot reload for development
QUEUE_HOT_RELOAD=false

# Enable debug mode
QUEUE_DEBUG=false

# Test mode (uses in-memory drivers by default)
QUEUE_TEST_MODE=false

# ============================================
# EXAMPLE USAGE
# ============================================

# For single-node in-memory queue:
# QUEUE_DRIVER=memory
# QUEUE_CONCURRENCY=10

# For multi-node shared memory queue:
# QUEUE_DRIVER=shared-memory
# CLUSTER_ENABLED=true
# CLUSTER_MIN_WORKERS=2
# CLUSTER_MAX_WORKERS=4

# For file-based persistent queue:
# QUEUE_DRIVER=file
# FILE_DRIVER_DATA_DIR=./data/queues

# For Redis-backed queue:
# QUEUE_DRIVER=redis
# REDIS_URL=redis://localhost:6379

# For production with monitoring:
# QUEUE_DRIVER=redis
# QUEUE_LOG_LEVEL=info
# QUEUE_METRICS_ENABLED=true
# QUEUE_HEALTH_CHECK_ENABLED=true
# QUEUE_HEALTH_CHECK_PORT=8080
